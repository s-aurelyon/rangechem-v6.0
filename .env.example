# Reference only: set these as environment variables (cPanel > Setup Python App). Never commit real values.

# --- Core ---
APP_ENV=production
PUBLIC_ORIGIN=https://your-domain.co.za
ADMIN_PASSWORD=at-least-16-random-characters

# --- Database (omit DB_ENGINE to use local SQLite) ---
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=account_rangechem
DB_USER=account_rcuser
DB_PASSWORD=
# SQLITE_PATH=data/rangechem.db

# --- Quote emails (nothing is sent unless SMTP_HOST and MAIL_FROM are set) ---
MAIL_FROM=quotes@your-domain.co.za
MAIL_NOTIFY=sales@your-domain.co.za
SMTP_HOST=mail.your-domain.co.za
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=quotes@your-domain.co.za
SMTP_PASSWORD=

# --- Local only ---
# HOST=127.0.0.1
# PORT=8000
